---
/*
  ============================ DIRECTION CONTRACT ============================
  THESIS: This portfolio is one executable notebook. Prose, code, and rendered
    output interleave so software + research + side projects read as a single
    line of reasoning. Refuses the dev-portfolio hero-and-grid and the
    clean-minimal whitespace template.
  OWN-WORLD: Cool technical paper ground (#F6F7F9, faint engineering grid) with
    white cells and contrasting dark "output" blocks (#16181D). JetBrains Mono
    carries all notebook chrome — In[n]:/Out[n]: prompts (fuchsia), Fig.N
    counters, nav, metadata, entry IDs. Hanken Grotesk for reading prose.
    Disciplined syntax palette: fuchsia prompt, emerald string, amber output,
    blue link. Recognizable with content removed by the prompt gutter +
    numbered cells + dark output figures.
  STORY: A recruiter/peer reads In[1] (who Aishwari is, the range), sees Fig.1
    the featured work rendered as live output, scrolls numbered cells
    (projects, research, writing) each demonstrating real artifacts, and reaches
    the Out cell with resume + contact — leaving with the coherence and a step.
  FIRST VIEWPORT: Mono masthead ("Aishwari Sirur ● notebook — kernel ready" +
    nav/resume/contact). Then In[1]: whoami() statement in prose, and Fig.1 the
    featured project as a dark output figure with an authored data panel.
  FORM: Computational notebook — #1 of the derived list; committed. Chosen via
    the structured-question channel (no networked roll / decision page).
  ===========================================================================
*/
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Aishwari Sirur — notebook',
  description = 'Aishwari Sirur — AI engineering intern candidate. CS at UC Davis working across AI, data science, and product. Portfolio rendered as a notebook.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Set theme before paint — no flash. Saved choice wins; else follow OS.
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          var dark = saved ? saved === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (dark) document.documentElement.setAttribute('data-theme', 'dark');
        } catch (e) {}
      })();
    </script>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Enable scroll-reveal only when JS runs and motion is allowed. Set on
      // <html> before paint so there is no flash of invisible cells.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js-anim');
      }
    </script>
  </head>
  <body>
    <header class="masthead">
      <div class="masthead-in">
        <div class="brand">
          <button
            class="kernel-dot"
            type="button"
            aria-label="Restart kernel"
            title="Restart kernel"
            data-kernel-restart
          ></button>
          <a class="brand-link" href="/">Aishwari&nbsp;Sirur</a>
          <span class="kernel-label" data-kernel-label>● notebook — kernel ready</span>
        </div>
        <nav class="nav" aria-label="Sections">
          <a class="hide-sm" href="/projects">projects</a>
          <a class="hide-sm" href="/log">log</a>
          <a class="cta" href="/resume">resume</a>
          <a class="cta kw" href="/contact">contact →</a>
          <button class="theme-toggle" type="button" aria-label="Toggle dark mode" data-theme-toggle>
            <span class="glyph" aria-hidden="true">◐</span> <span data-theme-label>dark</span>
          </button>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
      <footer class="foot">
        <span>© 2025 Aishwari Sirur — rendered as a notebook.</span>
        <span class="com"># built with Astro · aishwari sirur — ai engineer</span>
      </footer>
    </main>

    <script is:inline>
      // Theme toggle. Label shows the action (what a click switches TO).
      (function () {
        var root = document.documentElement;
        var btn = document.querySelector('[data-theme-toggle]');
        var label = document.querySelector('[data-theme-label]');
        function sync() {
          var dark = root.getAttribute('data-theme') === 'dark';
          if (label) label.textContent = dark ? 'light' : 'dark';
        }
        sync();
        if (btn) {
          btn.addEventListener('click', function () {
            var dark = root.getAttribute('data-theme') === 'dark';
            if (dark) root.removeAttribute('data-theme');
            else root.setAttribute('data-theme', 'dark');
            try { localStorage.setItem('theme', dark ? 'light' : 'dark'); } catch (e) {}
            sync();
          });
        }
      })();
    </script>
    <script is:inline>
      // Easter eggs — two, both leaning into the notebook-as-REPL fiction.
      (function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // 1) Click the "kernel ready" dot to restart the kernel.
        var dot = document.querySelector('[data-kernel-restart]');
        var label = document.querySelector('[data-kernel-label]');
        var restarting = false;
        if (dot) {
          dot.addEventListener('click', function () {
            if (restarting) return;
            restarting = true;
            dot.classList.add('restarting');
            if (label) label.textContent = '● restarting kernel…';
            window.setTimeout(function () {
              dot.classList.remove('restarting');
              if (label) label.textContent = '● notebook — kernel ready';
              restarting = false;
            }, reduce ? 500 : 1400);
          });
        }

        // 2) Type a command anywhere to run a hidden REPL cell.
        var COMMANDS = {
          whoami: 'aishwari sirur — ai engineer · cs @ uc davis · open to summer 2026',
          ls: 'projects/  log/  resume.pdf  contact/',
          help: "commands: whoami · ls · sudo hire · help  (esc to dismiss)",
          'sudo hire': ['permission granted → ', 'get in touch', '/contact'],
        };
        var buf = '';
        var clearTimer = null;
        var toast = null;
        var hideTimer = null;

        function ensureToast() {
          if (toast) return toast;
          toast = document.createElement('div');
          toast.className = 'repl-toast';
          toast.setAttribute('role', 'status');
          toast.setAttribute('aria-live', 'polite');
          document.body.appendChild(toast);
          return toast;
        }

        function run(cmd) {
          var out = COMMANDS[cmd];
          var t = ensureToast();
          var outHtml;
          if (Array.isArray(out)) {
            outHtml = out[0] + '<a href="' + out[2] + '">' + out[1] + '</a>';
          } else {
            outHtml = out;
          }
          t.innerHTML =
            '<div class="repl-in">&gt;&gt;&gt; <b>' + cmd + '</b></div>' +
            '<div class="repl-out">' + outHtml + '</div>';
          // reflow so the transition runs even on rapid re-trigger
          void t.offsetWidth;
          t.classList.add('show');
          if (hideTimer) window.clearTimeout(hideTimer);
          hideTimer = window.setTimeout(hide, 5000);
        }

        function hide() {
          if (toast) toast.classList.remove('show');
        }

        function typingInField(el) {
          if (!el) return false;
          var tag = el.tagName;
          return tag === 'INPUT' || tag === 'TEXTAREA' || el.isContentEditable;
        }

        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') { hide(); buf = ''; return; }
          if (typingInField(e.target)) return;
          if (e.metaKey || e.ctrlKey || e.altKey) return;
          if (e.key && e.key.length === 1 && /[a-z ]/i.test(e.key)) {
            buf = (buf + e.key.toLowerCase()).slice(-24);
            if (clearTimer) window.clearTimeout(clearTimer);
            clearTimer = window.setTimeout(function () { buf = ''; }, 2000);
            for (var cmd in COMMANDS) {
              if (COMMANDS.hasOwnProperty(cmd) && buf.slice(-cmd.length) === cmd) {
                run(cmd);
                buf = '';
                break;
              }
            }
          }
        });
      })();
    </script>
    <script>
      // Native notebook motion: cells "execute" (reveal) as they scroll in,
      // orchestrated once. Respects reduced-motion via CSS; here we just add the
      // run class. If IO is unavailable, everything is visible by default.
      const cells = document.querySelectorAll('.cell');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!('IntersectionObserver' in window) || reduce) {
        cells.forEach((c) => c.classList.add('run'));
      } else {
        // Reveal anything already in the first viewport synchronously — no
        // above-the-fold flash — then observe the rest.
        const vh = window.innerHeight;
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                (e.target as HTMLElement).classList.add('run');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
        );
        cells.forEach((c) => {
          if (c.getBoundingClientRect().top < vh * 0.9) c.classList.add('run');
          else io.observe(c);
        });
        // safety: reveal anything still hidden after load
        window.addEventListener('load', () =>
          setTimeout(() => cells.forEach((c) => c.classList.add('run')), 1200)
        );
      }
    </script>
  </body>
</html>
