---
import Notebook from '../layouts/Notebook.astro';

// Web3Forms access key. Public by design (spam-protected server-side).
// Set PUBLIC_WEB3FORMS_KEY in .env / Vercel, or replace the fallback below.
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY || '72ff3b51-d1e2-4622-82b4-6e4988f2cd51';
---

<Notebook
  title="Contact — Aishwari Sirur"
  description="Send Aishwari Sirur a message — lands straight in her inbox."
>
  <h1 class="sr-only">Contact Aishwari Sirur</h1>

  {/* In[1] — intro */}
  <section class="cell run">
    <div class="cell-gutter">In[<span>1</span>]:</div>
    <div class="cell-body">
      <a class="backlink" href="/">← back to notebook</a>
      <div class="celltag mono" style="margin-top:1rem"><span class="fn">contact</span>.open()</div>
      <p class="prose" style="font-size:1.2rem">
        Have a role, a project, or a question? Send a message — it lands straight
        in my inbox, and I'll get back to you.
      </p>
    </div>
  </section>

  {/* In[2] — the form */}
  <section class="cell run">
    <div class="cell-gutter">In[<span>2</span>]:</div>
    <div class="cell-body">
      <div class="celltag mono"><span class="fn">message</span>.compose()</div>
      <form id="contact-form" class="form" novalidate>
        <input type="hidden" name="access_key" value={accessKey} />
        <input type="hidden" name="subject" value="New message from your portfolio contact form" />
        <input type="hidden" name="from_name" value="Portfolio contact form" />
        {/* honeypot — bots fill this; humans never see it */}
        <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <div class="field">
          <label for="cf-name">name <span class="req">*</span></label>
          <input id="cf-name" name="name" type="text" required autocomplete="name" placeholder="Your name" />
        </div>
        <div class="field">
          <label for="cf-email">email <span class="req">*</span></label>
          <input id="cf-email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" />
        </div>
        <div class="field">
          <label for="cf-message">message <span class="req">*</span></label>
          <textarea id="cf-message" name="message" required placeholder="What's on your mind?"></textarea>
        </div>

        <button type="submit" class="btn-run">send <span class="arr">→</span></button>
        <p class="form-status mono" data-state="" role="status" aria-live="polite"></p>
      </form>

      <p class="comment-line" style="margin-top:1.5rem">or reach me directly —
        <a href="mailto:asirur@ucdavis.edu">email</a> ·
        <a href="https://www.linkedin.com/in/aishwari-sirur" rel="noopener">linkedin</a> ·
        <a href="https://github.com/acarva203" rel="noopener">github</a>
      </p>
    </div>
  </section>
</Notebook>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = form?.querySelector('.form-status') as HTMLElement | null;
  const btn = form?.querySelector('.btn-run') as HTMLButtonElement | null;

  function setStatus(msg: string, state: '' | 'ok' | 'err') {
    if (!status) return;
    status.textContent = msg;
    status.setAttribute('data-state', state);
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    if (btn) btn.disabled = true;
    setStatus('sending…', '');
    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: new FormData(form),
      });
      const data = await res.json();
      if (data.success) {
        form.reset();
        setStatus('✓ message sent — thanks, I\'ll be in touch.', 'ok');
      } else {
        setStatus('✗ ' + (data.message || 'Something went wrong. Try email instead.'), 'err');
      }
    } catch {
      setStatus('✗ network error — please email me directly instead.', 'err');
    } finally {
      if (btn) btn.disabled = false;
    }
  });
</script>
