---
import Notebook from '../layouts/Notebook.astro';
import { getCollection, render } from 'astro:content';
import { goals } from '../data/goals';

const raw = await getCollection('updates');
raw.sort((a, b) => (a.data.date < b.data.date ? 1 : -1)); // newest first
const items = await Promise.all(
  raw.map(async (u) => ({ data: u.data, Content: (await render(u)).Content }))
);
---

<Notebook
  title="Log — Aishwari Sirur"
  description="What Aishwari Sirur is currently building, learning, and reading — a running log."
>
  <h1 class="sr-only">Log — what Aishwari Sirur is currently working on</h1>

  {/* In[1] — intro */}
  <section class="cell run">
    <div class="cell-gutter">In[<span>1</span>]:</div>
    <div class="cell-body">
      <a class="backlink" href="/">← back to notebook</a>
      <div class="celltag mono" style="margin-top:1rem"><span class="fn">log</span>.stream()  <span class="com"># newest first</span></div>
      <p class="prose" style="font-size:1.15rem">
        A running log of what I'm building, learning, and reading right now. If
        you want to know what I'm actually up to this week, it's here.
      </p>
    </div>
  </section>

  {/* Out[*] — goals as progress bars */}
  <section class="cell run">
    <div class="cell-gutter">Out[<span class="out">*</span>]:</div>
    <div class="cell-body">
      <div class="celltag mono"><span class="fn">goals</span>.progress()</div>
      {goals.map((g) => (
        <div class="skillgroup">
          <div class="glabel">{g.group}</div>
          {g.items.map((it) => (
            <div class="goal">
              <span class="gname">{it.label}</span>
              <span class="gpct mono">{it.progress}%</span>
              <div class="gtrack" role="progressbar" aria-valuenow={it.progress} aria-valuemin="0" aria-valuemax="100" aria-label={it.label}>
                <div class="gfill" style={`width:${it.progress}%`}></div>
              </div>
            </div>
          ))}
        </div>
      ))}
    </div>
  </section>

  /*{/* the stream — timestamps sit in the prompt gutter */}
  {items.map((it) => (
    <section class="cell run">
      <div class="cell-gutter logdate">{it.data.date}</div>
      <div class="cell-body">
        <span class="logtag" data-tag={it.data.tag}>{it.data.tag}</span>
        <div class="logtitle">{it.data.title}</div>
        <div class="logbody"><it.Content /></div>
      </div>
    </section>
  ))}*/
</Notebook>
