---
import Notebook from '../layouts/Notebook.astro';
import { experience } from '../data/experience';

const skills = [
  {
    group: 'AI / ML & Data',
    items: ['Python', 'Scikit-Learn', 'Machine Learning', 'Statistics', 'Geospatial Data', 'Tableau', 'LLM fine-tuning (learning)', 'Agentic workflows (exploring)'],
  },
  {
    group: 'Product',
    items: ['Figma', 'Notion', 'Qualtrics', 'User Interviews', 'Roadmapping', 'Workflow Automation'],
  },
  {
    group: 'Design & Front-end',
    items: ['UI/UX', 'Prototyping', 'Design Systems', 'Usability Testing', 'React'],
  },
];
---

<Notebook
  title="Résumé — Aishwari Sirur"
  description="Résumé of Aishwari Sirur — AI engineering intern candidate. Education, skills, and experience, with a downloadable PDF."
>
  <h1 class="sr-only">Résumé — Aishwari Sirur, AI Engineer</h1>

  {/* In[1] — header */}
  <section class="cell run">
    <div class="cell-gutter">In[<span>1</span>]:</div>
    <div class="cell-body">
      <a class="backlink" href="/">← back to notebook</a>
      <div class="celltag mono" style="margin-top:1rem"><span class="fn">resume</span>.load()</div>
      <p class="prose lead" style="margin-top:0.4rem">
        <strong>Aishwari Sirur</strong> — AI Engineer.
      </p>
      <p class="comment-line">cs @ uc davis · seeking a summer 2026 ai engineering internship</p>
    </div>
  </section>

  {/* In[2] — education */}
  <section class="cell run">
    <div class="cell-gutter">In[<span>2</span>]:</div>
    <div class="cell-body">
      <div class="celltag mono"><span class="fn">education</span></div>
      <div class="entries">
        <div class="entry entry--static">
          <span class="entry-id">▹</span>
          <span class="entry-main">
            <span class="entry-title">University of California, Davis</span>
            <span class="entry-refs"><span class="venue">B.S. Computer Science</span> · concentrations in Technology Management &amp; Statistics</span>
          </span>
        </div>
      </div>
    </div>
  </section>

  {/* In[3] — skills */}
  <section class="cell run">
    <div class="cell-gutter">In[<span>3</span>]:</div>
    <div class="cell-body">
      <div class="celltag mono"><span class="fn">skills</span></div>
      {skills.map((s) => (
        <div class="skillgroup">
          <div class="glabel">{s.group}</div>
          <div class="chips chips--light" style="margin-top:0">
            {s.items.map((it) => <span class="chip">{it}</span>)}
          </div>
        </div>
      ))}
    </div>
  </section>

  {/* In[4] — experience */}
  <section class="cell run">
    <div class="cell-gutter">In[<span>4</span>]:</div>
    <div class="cell-body">
      <div class="celltag mono"><span class="fn">experience</span>.timeline()</div>
      <div class="entries">
        {experience.map((r) => (
          <div class="entry entry--static">
            <span class="entry-id">▹</span>
            <span class="entry-main">
              <span class="entry-title">{r.role}</span>
              <span class="entry-refs"><span class="venue">{r.org}</span>{r.location ? ` · ${r.location}` : ''}</span>
              <span class="entry-blurb">{r.points.join(' · ')}</span>
            </span>
            <span class="entry-meta">{r.period}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Out[] — PDF download at the end of the page */}
  <section class="cell run">
    <div class="cell-gutter">Out[<span class="out">∎</span>]:</div>
    <div class="cell-body">
      <div class="outcell">
        <h2>Prefer the PDF?</h2>
        <p>The one-page version, ready to download or forward.</p>
        <div class="outlinks">
          <a href="/resume.pdf" download>download résumé (PDF) <span class="arr">↓</span></a>
          <a href="/contact">get in touch <span class="arr">→</span></a>
        </div>
      </div>
    </div>
  </section>
</Notebook>
