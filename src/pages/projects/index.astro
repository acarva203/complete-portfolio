---
import Notebook from '../../layouts/Notebook.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);
const catCode: Record<string, string> = {
  'AI / ML': 'AI',
  'Data Science': 'DS',
  Product: 'PM',
  Design: 'DES',
  Engineering: 'ENG',
};
---

<Notebook title="Projects — Aishwari Sirur" description="Everything Aishwari Sirur has built — AI/ML, data science, product, and design.">
  <section class="cell run">
    <div class="cell-gutter">In[<span>*</span>]:</div>
    <div class="cell-body">
      <a class="backlink" href="/#projects">← back to notebook</a>
      <h1 class="sr-only">Projects — Aishwari Sirur</h1>
      <div class="celltag mono" style="margin-top:1rem">
        <span class="fn">projects</span>.list(all=<span class="kw">True</span>)  <span class="com"># {projects.length} entries</span>
      </div>
      <div class="entries">
        {projects.map((p, i) => (
          <a class="entry" href={`/project/${p.id}`}>
            <span class="entry-id">{catCode[p.data.categories[0]] ?? 'SR'}·{String(i + 1).padStart(3, '0')}</span>
            <span class="entry-main">
              <span class="entry-title">
                {p.data.title}{' '}
                {p.data.featured && <span class="com mono" style="font-size:11px">★ featured</span>}
                {p.data.href && <span class="arr">↗</span>}
              </span>
              <span class="entry-blurb">{p.data.blurb}</span>
            </span>
            <span class="entry-meta">{p.data.categories.join(' · ')} · {p.data.timeline}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Notebook>
